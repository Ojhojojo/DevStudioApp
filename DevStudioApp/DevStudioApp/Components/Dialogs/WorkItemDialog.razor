@using DevStudioApp.Services
@using DevStudioDomain
@using DevStudioDomain.Entities
@using MudBlazor
@inject IWorkItemService WorkItemService
@inject IWorkItemGitService WorkItemGitService
@inject ICopilotCliService CopilotCliService
@inject IPlanningService PlanningService
@inject ISnackbar Snackbar
@inject ILogger<WorkItemDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "New Task" : "Edit Task")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_model.Title" Label="Title" Required="true" RequiredError="Title is required" />

            <MudText Typo="Typo.subtitle2">Description</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="Description (markdown)"
                                  Lines="12"
                                  AutoGrow="true"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">Preview</MudText>
                        <MudMarkdown Value="@(_model.Description ?? string.Empty)" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (!IsNew)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2">Status</MudText>
                    <MudChip T="string" Color="@StatusColor(_model.Status)" Size="Size.Small">
                        @KanbanStatuses.DisplayLabel(_model.Status)
                    </MudChip>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Drag the card on the board to change status.
                    </MudText>
                </MudStack>

                <MudTextField @bind-Value="_model.BranchName" Label="Branch (optional)" />
                <MudTextField @bind-Value="_model.PullRequestUrl" Label="Pull Request URL (optional)" />
                <MudDivider />
                <MudText Typo="Typo.subtitle2">Phase 6 Planning</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               Disabled="@_isGeneratingPlan"
                               OnClick="GeneratePlanAsync">
                        Generate Plan
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@_isGeneratingPlan"
                               OnClick="SavePlanOnlyAsync">
                        Save Plan
                    </MudButton>
                </MudStack>
                <MudTextField @bind-Value="_model.Plan" Label="Plan (review/edit)" Lines="8" Variant="Variant.Outlined" />
                <MudTextField Value="_planContextSummary" Label="Context summary" Lines="4" ReadOnly="true" Variant="Variant.Outlined" />
                <MudTextField Value="_planDiagnostics" Label="Planning diagnostics" Lines="2" ReadOnly="true" Variant="Variant.Outlined" />

                <MudDivider />
                <MudText Typo="Typo.subtitle2">Happy-path automation</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@_isGitBusy"
                               OnClick="CommitAsync">
                        Commit
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Disabled="@_isGitBusy"
                               OnClick="PushAsync">
                        Push
                    </MudButton>
                </MudStack>
                <MudTextField @bind-Value="_copilotPrompt"
                              Label="Copilot instruction"
                              Lines="4"
                              Variant="Variant.Outlined" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Disabled="@_isCopilotRunning"
                           OnClick="RunCopilotAsync">
                    Run Copilot
                </MudButton>
                <MudTextField Value="_copilotOutput"
                              Label="Copilot output"
                              Lines="8"
                              ReadOnly="true"
                              Variant="Variant.Outlined" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (!IsNew)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="DeleteAsync">
                Delete
            </MudButton>
            <MudSpacer />
        }
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public WorkItem? Item { get; set; }
    [Parameter] public int? ProjectId { get; set; }

    private WorkItem _model = new();
    private bool IsNew => _model.Id == 0;
    private bool _isGitBusy;
    private bool _isCopilotRunning;
    private bool _isGeneratingPlan;
    private string _copilotPrompt = string.Empty;
    private string _copilotOutput = string.Empty;
    private string _planContextSummary = string.Empty;
    private string _planDiagnostics = string.Empty;

    protected override void OnInitialized()
    {
        if (Item is not null)
        {
            _model = new WorkItem
            {
                Id = Item.Id,
                ProjectId = Item.ProjectId,
                Title = Item.Title,
                Description = Item.Description,
                Status = Item.Status,
                Order = Item.Order,
                Plan = Item.Plan,
                BranchName = Item.BranchName,
                PullRequestUrl = Item.PullRequestUrl
            };
        }
        else
        {
            _model = new WorkItem
            {
                ProjectId = ProjectId ?? 0,
                Status = KanbanStatuses.Backlog
            };
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            Snackbar.Add("Title is required.", Severity.Warning);
            return;
        }

        try
        {
            if (IsNew)
            {
                if (_model.ProjectId == 0)
                {
                    Snackbar.Add("No active project selected.", Severity.Warning);
                    return;
                }

                var created = await WorkItemService.CreateAsync(_model.ProjectId, _model.Title, _model.Description ?? string.Empty);
                Logger.LogInformation("Created WorkItem {Id} ({Title}) in project {ProjectId}", created.Id, created.Title, _model.ProjectId);
                MudDialog.Close(DialogResult.Ok(created));
            }
            else
            {
                var updated = await WorkItemService.UpdateAsync(_model);
                Logger.LogInformation("Updated WorkItem {Id} ({Title})", updated.Id, updated.Title);
                MudDialog.Close(DialogResult.Ok(updated));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save WorkItem.");
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await WorkItemService.DeleteAsync(_model.Id);
            Logger.LogInformation("Deleted WorkItem {Id}", _model.Id);
            MudDialog.Close(DialogResult.Ok((object?)"deleted"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete WorkItem {Id}.", _model.Id);
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CommitAsync()
    {
        if (IsNew)
        {
            Snackbar.Add("Save this task first before committing.", Severity.Warning);
            return;
        }

        _isGitBusy = true;
        try
        {
            var message = $"feat(work-item): {_model.Id} {_model.Title}".Trim();
            var result = await WorkItemGitService.CommitWorkItemChangesAsync(_model, message);
            Snackbar.Add(result, Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Commit failed for WorkItem {Id}", _model.Id);
            Snackbar.Add($"Commit failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGitBusy = false;
        }
    }

    private async Task PushAsync()
    {
        if (IsNew)
        {
            Snackbar.Add("Save this task first before pushing.", Severity.Warning);
            return;
        }

        _isGitBusy = true;
        try
        {
            var result = await WorkItemGitService.PushWorkItemBranchAsync(_model);
            Snackbar.Add(result, Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Push failed for WorkItem {Id}", _model.Id);
            Snackbar.Add($"Push failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGitBusy = false;
        }
    }

    private async Task RunCopilotAsync()
    {
        if (IsNew)
        {
            Snackbar.Add("Save this task first before running Copilot.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_copilotPrompt))
        {
            Snackbar.Add("Enter a Copilot instruction first.", Severity.Warning);
            return;
        }

        _isCopilotRunning = true;
        _copilotOutput = string.Empty;

        try
        {
            var result = await CopilotCliService.RunForWorkItemAsync(
                _model,
                _copilotPrompt,
                line =>
                {
                    _copilotOutput += line + Environment.NewLine;
                    _ = InvokeAsync(StateHasChanged);
                });

            if (result.Succeeded)
            {
                Snackbar.Add("Copilot run completed.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Copilot exited with code {result.ExitCode}.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Copilot run failed for WorkItem {Id}", _model.Id);
            Snackbar.Add($"Copilot failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCopilotRunning = false;
        }
    }

    private async Task GeneratePlanAsync()
    {
        if (IsNew)
        {
            Snackbar.Add("Save this task first before generating a plan.", Severity.Warning);
            return;
        }

        _isGeneratingPlan = true;
        _planDiagnostics = string.Empty;
        _planContextSummary = string.Empty;
        try
        {
            var result = await PlanningService.GeneratePlanAsync(_model);
            _planContextSummary = result.ContextSummary;
            _planDiagnostics = result.Diagnostics;
            if (result.Succeeded)
            {
                _model.Plan = result.GeneratedPlan;
                Snackbar.Add("Plan generated. Review and save when ready.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Plan generation finished with warnings. Review diagnostics.", Severity.Warning);
            }

            Logger.LogInformation("Generated plan for WorkItem {Id}. Success={Success}", _model.Id, result.Succeeded);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Plan generation failed for WorkItem {Id}", _model.Id);
            Snackbar.Add($"Plan generation failed: {ex.Message}", Severity.Error);
            _planDiagnostics = ex.Message;
        }
        finally
        {
            _isGeneratingPlan = false;
        }
    }

    private async Task SavePlanOnlyAsync()
    {
        if (IsNew)
        {
            Snackbar.Add("Save this task first before saving plan updates.", Severity.Warning);
            return;
        }

        try
        {
            var updated = await WorkItemService.UpdateAsync(_model);
            _model = updated;
            Snackbar.Add("Plan saved.", Severity.Success);
            Logger.LogInformation("Saved plan for WorkItem {Id}", _model.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save plan for WorkItem {Id}", _model.Id);
            Snackbar.Add($"Save plan failed: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static Color StatusColor(string status) => status switch
    {
        KanbanStatuses.Backlog => Color.Default,
        KanbanStatuses.Planned => Color.Info,
        KanbanStatuses.InProgress => Color.Warning,
        KanbanStatuses.Review => Color.Secondary,
        KanbanStatuses.Done => Color.Success,
        _ => Color.Default
    };
}
