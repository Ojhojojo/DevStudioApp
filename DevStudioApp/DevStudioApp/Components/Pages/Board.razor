@page "/board"
@using DevStudioApp.Components.Dialogs
@using DevStudioApp.Services
@using DevStudioDomain
@using DevStudioDomain.Entities
@implements IDisposable
@inject IActiveProjectStore ActiveProjectStore
@inject IWorkItemService WorkItemService
@inject IWorkItemBranchService WorkItemBranchService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ILogger<Board> Logger

<PageTitle>Board</PageTitle>

@if (ActiveProjectStore.Current is null)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.ViewKanban" Size="Size.Large" Class="mb-4" />
        <MudText Typo="Typo.h5" Class="mb-2">No active project</MudText>
        <MudText Class="mb-4 mud-text-secondary">Select or create a project to start working on tasks.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/projects">
            Open Projects
        </MudButton>
    </MudPaper>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.ViewKanban" />
            <MudText Typo="Typo.h5">@ActiveProjectStore.Current.Name</MudText>
            <MudSpacer />
            <MudTextField T="string"
                          Value="_search"
                          ValueChanged="OnSearchChanged"
                          DebounceInterval="300"
                          Placeholder="Search tasks..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Style="max-width: 320px;" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenNewTaskDialogAsync">
                New Task
            </MudButton>
        </MudStack>

        <MudDropContainer T="WorkItem"
                          @ref="_dropContainer"
                          Items="_items"
                          ItemsSelector="@((item, dropZoneIdentifier) => item.Status == dropZoneIdentifier)"
                          ItemDropped="OnItemDroppedAsync"
                          Class="d-flex flex-row gap-3"
                          Style="overflow-x: auto;">
            <ChildContent>
                @foreach (var status in KanbanStatuses.All)
                {
                    var laneCount = _items.Count(i => i.Status == status);
                    <MudPaper Class="pa-2 flex-1" Style="min-width: 280px; min-height: 60vh;" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.subtitle1">@KanbanStatuses.DisplayLabel(status)</MudText>
                            <MudSpacer />
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@laneCount</MudChip>
                        </MudStack>
                        <MudDropZone T="WorkItem"
                                     Identifier="@status"
                                     Class="d-flex flex-column gap-2"
                                     Style="min-height: 50vh;" />
                    </MudPaper>
                }
            </ChildContent>
            <ItemRenderer>
                <MudPaper Class="pa-3 cursor-pointer"
                          Elevation="2"
                          @onclick="() => OpenEditDialogAsync(context)">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body1"><b>@context.Title</b></MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary text-truncate">
                                @TruncateDescription(context.Description)
                            </MudText>
                        }
                        <MudStack Row="true" Spacing="1">
                            @if (!string.IsNullOrWhiteSpace(context.BranchName))
                            {
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Commit">@context.BranchName</MudChip>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </ItemRenderer>
        </MudDropContainer>
    </MudStack>
}

@code {
    private MudDropContainer<WorkItem>? _dropContainer;
    private List<WorkItem> _items = new();
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ActiveProjectStore.OnChange += HandleActiveChanged;
        await LoadAsync();
    }

    private async void HandleActiveChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        if (ActiveProjectStore.Current is null)
        {
            _items = new();
            return;
        }

        _items = await WorkItemService.ListByProjectAsync(ActiveProjectStore.Current.Id, _search);
        _dropContainer?.Refresh();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        await LoadAsync();
    }

    private async Task OnItemDroppedAsync(MudItemDropInfo<WorkItem> info)
    {
        if (info.Item is null || string.IsNullOrWhiteSpace(info.DropzoneIdentifier))
        {
            return;
        }

        var item = info.Item;
        var targetStatus = info.DropzoneIdentifier;
        var targetIndex = info.IndexInZone;

        try
        {
            var isPlannedToInProgress =
                string.Equals(item.Status, KanbanStatuses.Planned, StringComparison.Ordinal) &&
                string.Equals(targetStatus, KanbanStatuses.InProgress, StringComparison.Ordinal);

            if (isPlannedToInProgress && string.IsNullOrWhiteSpace(item.BranchName))
            {
                var branchResult = await WorkItemBranchService.ProvisionForInProgressAsync(item);
                await WorkItemService.SetBranchNameAsync(item.Id, branchResult.BranchName);
                Snackbar.Add($"Branch ready: {branchResult.BranchName}", Severity.Success);

                Logger.LogInformation(
                    "Provisioned branch {BranchName} from {BaseBranch} for WorkItem {Id}",
                    branchResult.BranchName,
                    branchResult.BaseBranch,
                    item.Id);
            }

            await WorkItemService.MoveAsync(item.Id, targetStatus, targetIndex);
            Logger.LogInformation("Moved WorkItem {Id} to {Status}@{Index}", item.Id, targetStatus, targetIndex);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to move WorkItem {Id} to {Status}@{Index}", item.Id, targetStatus, targetIndex);
            Snackbar.Add($"Move failed: {ex.Message}", Severity.Error);
            await LoadAsync();
        }
    }

    private async Task OpenNewTaskDialogAsync()
    {
        if (ActiveProjectStore.Current is null)
        {
            return;
        }

        var options = new DialogOptions
        {
            FullWidth = true
        };

        var parameters = new DialogParameters<WorkItemDialog>
        {
            { x => x.ProjectId, ActiveProjectStore.Current.Id }
            
        };
        var dialog = await DialogService.ShowAsync<WorkItemDialog>("New Task", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialogAsync(WorkItem item)
    {
        var options = new DialogOptions
        {
            FullWidth = true
        };

        var parameters = new DialogParameters<WorkItemDialog>
        {
            { x => x.Item, item }
        };
        var dialog = await DialogService.ShowAsync<WorkItemDialog>("Edit Task", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private static string TruncateDescription(string description)
    {
        if (description.Length <= 140)
        {
            return description;
        }
        return description[..140] + "...";
    }

    public void Dispose()
    {
        ActiveProjectStore.OnChange -= HandleActiveChanged;
    }
}
