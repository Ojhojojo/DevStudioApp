@inherits LayoutComponentBase
@implements IDisposable
@using DevStudioApp.Services
@using DevStudioDomain.Entities
@inject NavigationManager NavigationManager
@inject ISetupStatusService SetupStatusService
@inject IActiveProjectStore ActiveProjectStore
@inject IProjectService ProjectService
@inject IAppSettingsService AppSettingsService

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">Dev Agent Studio</MudText>

        <MudMenu Class="ml-4"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ActivatorContent>
                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Folder"
                           EndIcon="@Icons.Material.Filled.ArrowDropDown">
                    @(ActiveProjectStore.Current?.Name ?? "No project selected")
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                @if (_projects.Count == 0)
                {
                    <MudMenuItem Disabled="true">No projects available</MudMenuItem>
                }
                else
                {
                    @foreach (var project in _projects)
                    {
                        var isActive = ActiveProjectStore.Current?.Id == project.Id;
                        <MudMenuItem OnClick="() => SelectProjectAsync(project.Id)"
                                     Icon="@(isActive ? Icons.Material.Filled.Check : null)">
                            @project.Name
                        </MudMenuItem>
                    }
                }
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="GoToProjects">
                    Manage projects...
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudSpacer />
        <MudIconButton
            Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
            Color="Color.Inherit"
            OnClick="ToggleThemeAsync"
            aria-label="Toggle theme" />
        <MudIconButton
            Icon="@Icons.Material.Filled.Settings"
            Color="Color.Inherit"
            Href="/settings"
            aria-label="Open settings" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _isCheckingSetup;
    private List<Project> _projects = new();

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = Colors.Blue.Darken2
        },
        PaletteDark = new PaletteDark
        {
            Primary = Colors.Blue.Lighten1
        }
    };

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        ActiveProjectStore.OnChange += HandleActiveChanged;

        var settings = await AppSettingsService.GetAsync();
        _isDarkMode = string.Equals(settings.Theme, "dark", StringComparison.OrdinalIgnoreCase);

        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        _projects = await ProjectService.ListAsync();
    }

    private async void HandleActiveChanged()
    {
        await LoadProjectsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectProjectAsync(int projectId)
    {
        await ActiveProjectStore.SetActiveAsync(projectId);
        NavigationManager.NavigateTo("/board");
    }

    private void GoToProjects() => NavigationManager.NavigateTo("/projects");

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        var settings = await AppSettingsService.GetAsync();
        settings.Theme = _isDarkMode ? "dark" : "light";
        await AppSettingsService.SaveAsync(settings);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await EnforceSetupAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnforceSetupAsync();
        }
    }

    private async Task EnforceSetupAsync()
    {
        if (_isCheckingSetup)
        {
            return;
        }

        _isCheckingSetup = true;
        try
        {
            var status = await SetupStatusService.GetStatusAsync();
            if (status.IsComplete)
            {
                return;
            }

            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
            var isAllowedRoute = string.IsNullOrWhiteSpace(path)
                || path.StartsWith("settings")
                || path.StartsWith("projects")
                || path.StartsWith("onboarding")
                || path.StartsWith("board");

            if (!isAllowedRoute)
            {
                NavigationManager.NavigateTo("/onboarding");
            }
        }
        finally
        {
            _isCheckingSetup = false;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ActiveProjectStore.OnChange -= HandleActiveChanged;
    }
}
